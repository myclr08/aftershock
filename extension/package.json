{
  "name": "aftershock",
  "displayName": "Aftershock",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "aftershock-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/myclr08/aftershock.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/myclr08/aftershock/issues"
  },
  "homepage": "https://github.com/myclr08/aftershock#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "dotnet",
    "csharp",
    "xunit",
    "nunit",
    "mstest",
    "impacted tests",
    "roslyn"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aftershock.runAllTests",
        "title": "%command.runAllTests%",
        "category": "Aftershock"
      },
      {
        "command": "aftershock.showImpactedTests",
        "title": "%command.showImpactedTests%",
        "category": "Aftershock"
      },
      {
        "command": "aftershock.recomputeCoverage",
        "title": "%command.recomputeCoverage%",
        "category": "Aftershock"
      },
      {
        "command": "aftershock.togglePause",
        "title": "%command.togglePause%",
        "category": "Aftershock"
      },
      {
        "command": "aftershock.restartAnalyzer",
        "title": "%command.restartAnalyzer%",
        "category": "Aftershock"
      },
      {
        "command": "aftershock.showOutput",
        "title": "%command.showOutput%",
        "category": "Aftershock"
      }
    ],
    "configuration": {
      "title": "Aftershock",
      "properties": {
        "aftershock.solution": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.solution%"
        },
        "aftershock.debounceMs": {
          "type": "integer",
          "default": 1500,
          "minimum": 0,
          "maximum": 60000,
          "scope": "resource",
          "markdownDescription": "%config.debounceMs%"
        },
        "aftershock.maxImpactedSymbols": {
          "type": "integer",
          "default": 500,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "%config.maxImpactedSymbols%"
        },
        "aftershock.fallbackGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/appsettings*.json"
          ],
          "scope": "resource",
          "markdownDescription": "%config.fallbackGlobs%"
        },
        "aftershock.testFilter": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.testFilter%"
        },
        "aftershock.disableAnalyzersInBuild": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.disableAnalyzersInBuild%"
        },
        "aftershock.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "markdownDescription": "%config.dotnetPath%"
        },
        "aftershock.coverageEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.coverageEnabled%"
        },
        "aftershock.targetBranch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.targetBranch%"
        },
        "aftershock.coverageThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 0,
          "maximum": 100,
          "scope": "resource",
          "markdownDescription": "%config.coverageThreshold%"
        },
        "aftershock.coverageTool": {
          "type": "string",
          "enum": [
            "coverlet",
            "microsoft"
          ],
          "markdownEnumDescriptions": [
            "%config.coverageTool.coverlet%",
            "%config.coverageTool.microsoft%"
          ],
          "default": "coverlet",
          "scope": "resource",
          "markdownDescription": "%config.coverageTool%"
        },
        "aftershock.coverageExclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.coverageExclusions%"
        },
        "aftershock.coverageDecorations": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.coverageDecorations%"
        }
      }
    },
    "colors": [
      {
        "id": "aftershock.uncoveredLineBackground",
        "description": "%color.uncoveredLineBackground%",
        "defaults": {
          "dark": "#f14c4c1f",
          "light": "#e5140014",
          "highContrast": "#f14c4c33",
          "highContrastLight": "#e5140026"
        }
      },
      {
        "id": "aftershock.partialLineBackground",
        "description": "%color.partialLineBackground%",
        "defaults": {
          "dark": "#cca7001f",
          "light": "#bf880314",
          "highContrast": "#cca70033",
          "highContrastLight": "#bf880326"
        }
      },
      {
        "id": "aftershock.uncoveredLineRuler",
        "description": "%color.uncoveredLineRuler%",
        "defaults": {
          "dark": "#f14c4c",
          "light": "#e51400",
          "highContrast": "#f14c4c",
          "highContrastLight": "#e51400"
        }
      },
      {
        "id": "aftershock.partialLineRuler",
        "description": "%color.partialLineRuler%",
        "defaults": {
          "dark": "#cca700",
          "light": "#bf8803",
          "highContrast": "#cca700",
          "highContrastLight": "#bf8803"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod && npm run bundle-analyzer",
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "bundle-analyzer": "node scripts/bundle-analyzer.mjs",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src test scripts esbuild.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:integration": "node esbuild.mjs && node test/integration/runTest.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "fast-xml-parser": "^5.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.0"
  }
}
